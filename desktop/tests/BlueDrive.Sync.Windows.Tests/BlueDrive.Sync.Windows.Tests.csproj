<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Builds on the Linux CI runners too; the tests only run on Windows (scripts/ci.ps1). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Files On-Demand tests on a real NTFS volume (Windows only; registers a temporary sync root).</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BlueDrive.Sync.Windows\BlueDrive.Sync.Windows.csproj" />
    <ProjectReference Include="..\BlueDrive.Sync.Testing\BlueDrive.Sync.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="BlueDrive.Sync.Testing" />
  </ItemGroup>
</Project>
