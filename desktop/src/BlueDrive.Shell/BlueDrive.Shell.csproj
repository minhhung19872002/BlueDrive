<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows 11 Explorer context menu (spec 7.2): IExplorerCommand COM server, NativeAOT DLL hosted by the MSIX package
         (desktop4:FileExplorerContextMenus + com:SurrogateServer). No .NET runtime needed in dllhost. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>BlueDrive.Shell</RootNamespace>
    <AssemblyName>BlueDrive.Shell</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
