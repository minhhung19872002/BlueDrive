<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BlueDrive.Desktop.ViewModels"
        x:Class="BlueDrive.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        x:Name="Root"
        Title="Cài đặt BlueDrive" Width="760" Height="560" MinWidth="620" MinHeight="460" WindowStartupLocation="CenterScreen"
        Icon="/Assets/bluedrive.ico">
  <DockPanel>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding Busy}" Height="3" />
    <TabControl TabStripPlacement="Left" Padding="16">
      <TabItem Header="Tài khoản">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Content="Thêm tài khoản" Command="{Binding AddAccountCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Accounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountRow">
                  <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" Classes="h2" />
                        <TextBlock Text="{Binding Server}" Classes="muted" />
                        <TextBlock><Run Text="Thư mục: " /><Run Text="{Binding Folder}" /></TextBlock>
                        <TextBlock><Run Text="Chế độ: " /><Run Text="{Binding Mode}" /></TextBlock>
                        <TextBlock Text="{Binding Quota}" Classes="muted" />
                      </StackPanel>
                      <Button Grid.Column="1" VerticalAlignment="Top" Content="Hủy liên kết máy này"
                              Command="{Binding #Root.((vm:SettingsViewModel)DataContext).UnlinkCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Header="Đồng bộ">
        <ScrollViewer>
          <StackPanel Spacing="12">
            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" MinWidth="280">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountRow"><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Thư mục BlueDrive" Classes="h2" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Folder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Mở" Command="{Binding OpenFolderCommand}" />
                <Button Content="Đổi vị trí…" Command="{Binding MoveFolderCommand}" IsEnabled="{Binding !Busy}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Chọn thư mục hiện trên máy này" Classes="h2" Margin="0,8,0,0" />
            <TreeView ItemsSource="{Binding RootToggles}" MaxHeight="260">
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:RootToggle" ItemsSource="{Binding Children}">
                  <CheckBox IsChecked="{Binding Included}" Content="{Binding Name}" />
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <TextBlock Text="Tệp theo yêu cầu" Classes="h2" Margin="0,8,0,0" />
            <ToggleSwitch IsChecked="{Binding OnDemand}" IsEnabled="{Binding OnDemandAvailable}" OnContent="Bật — chỉ tải tệp khi mở" OffContent="Tắt — tải mọi tệp về máy" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Giải phóng dung lượng cho tệp không dùng:" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding FreeUpLabels}" SelectedIndex="{Binding FreeUpIndex}" MinWidth="160" />
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding DoubleClickAvailable}">
              <TextBlock Text="Khi nhấp đúp tệp Office trong BlueDrive" Classes="h2" Margin="0,8,0,0" />
              <ComboBox ItemsSource="{Binding DoubleClickLabels}" SelectedIndex="{Binding DoubleClickIndex}" MinWidth="320" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Chế độ cùng soạn mở tài liệu trong ONLYOFFICE Desktop Editors (hoặc trình duyệt) để cùng sửa với người khác; khi mất mạng tệp trên máy được mở bằng ứng dụng mặc định. Áp dụng cho mọi thư mục BlueDrive." />
            </StackPanel>
            <TextBlock Text="Không đồng bộ các tệp/thư mục" Classes="h2" Margin="0,8,0,0" />
            <TextBlock Text="{Binding IgnoreList}" TextWrapping="Wrap" Classes="muted" />
            <TextBlock Text="{Binding SyncMessage}" TextWrapping="Wrap" Foreground="#0b5394" />
            <Button Content="Lưu" Command="{Binding SaveCommand}" Classes="accent" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Mạng">
        <StackPanel Spacing="12">
          <TextBlock Text="Giới hạn băng thông (KB/giây, 0 = không giới hạn)" Classes="h2" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Tải lên:" Width="80" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding UploadLimit}" Minimum="0" Maximum="1000000" Increment="100" FormatString="0" Width="180" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Tải xuống:" Width="80" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding DownloadLimit}" Minimum="0" Maximum="1000000" Increment="100" FormatString="0" Width="180" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Số luồng tải song song:" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding ParallelTransfers}" Minimum="1" Maximum="8" Increment="1" FormatString="0" Width="120" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Số tệp được tải xuống cùng lúc (chế độ đồng bộ đầy đủ); áp dụng ở lần khởi động sau." />
          <TextBlock Text="Đồng bộ trong mạng LAN" Classes="h2" Margin="0,8,0,0" />
          <CheckBox IsChecked="{Binding LanSync}" IsEnabled="{Binding LanSyncEditable}"
                    Content="Lấy tệp từ máy BlueDrive khác cùng mạng thay vì tải từ máy chủ (và cho máy khác lấy tệp từ máy này)" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Máy chủ vẫn kiểm tra quyền từng lần lấy tệp; nội dung được mã hóa và kiểm tra mã băm, lỗi thì tải từ máy chủ. Chỉ gửi bản đã đồng bộ, không gửi bản đang sửa. Windows có thể hỏi cho phép BlueDrive qua tường lửa (mạng riêng). Áp dụng ở lần khởi động sau." />
          <TextBlock Classes="muted" FontSize="12" Text="Do đơn vị quản lý (chính sách)." IsVisible="{Binding LanSyncLocked}" />
          <TextBlock Text="Proxy" Classes="h2" Margin="0,8,0,0" />
          <ComboBox ItemsSource="{Binding ProxyLabels}" SelectedIndex="{Binding ProxyIndex}" MinWidth="260" />
          <TextBox Text="{Binding ProxyAddress}" Watermark="http://proxy.donvi.gov.vn:8080" IsVisible="{Binding ManualProxy}" />
          <TextBlock Text="Tiết kiệm" Classes="h2" Margin="0,8,0,0" />
          <CheckBox IsChecked="{Binding PauseOnMetered}" Content="Tạm dừng đồng bộ khi dùng mạng tính phí (điểm phát di động, gói dữ liệu)" />
          <CheckBox IsChecked="{Binding PauseOnLowBattery}" Content="Tạm dừng đồng bộ khi máy chạy pin dưới 20%" />
          <Button Content="Lưu" Command="{Binding SaveCommand}" Classes="accent" HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Chung">
        <StackPanel Spacing="12">
          <CheckBox IsChecked="{Binding StartWithWindows}" Content="Khởi động BlueDrive cùng Windows" />
          <CheckBox IsChecked="{Binding Notifications}" Content="Hiện thông báo" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Giao diện:" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding ThemeLabels}" SelectedIndex="{Binding ThemeIndex}" MinWidth="180" />
          </StackPanel>
          <TextBlock Text="Ngôn ngữ: Tiếng Việt" Classes="muted" />
          <Button Content="Lưu" Command="{Binding SaveCommand}" Classes="accent" HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Vấn đề">
        <DockPanel>
          <Button DockPanel.Dock="Top" Content="Làm mới" Command="{Binding RefreshProblemsCommand}" HorizontalAlignment="Right" Margin="0,0,0,8" />
          <TextBlock DockPanel.Dock="Top" Text="Không có vấn đề nào." Classes="muted" IsVisible="{Binding !Problems.Count}" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Problems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProblemItem">
                  <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Classes="muted" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Xử lý xung đột…" IsVisible="{Binding IsConflict}" Classes="accent"
                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).ResolveProblemCommand}" CommandParameter="{Binding}" />
                        <Button Content="Giữ cả hai" IsVisible="{Binding IsConflict}"
                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).IgnoreCommand}" CommandParameter="{Binding}" />
                        <Button Content="Thử lại" IsVisible="{Binding IsError}"
                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RetryCommand}" CommandParameter="{Binding}" />
                        <Button Content="Mở vị trí"
                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).OpenLocationCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Header="Giới thiệu">
        <StackPanel Spacing="12">
          <Image Source="/Assets/bluedrive-256.png" Width="64" Height="64" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding Version}" Classes="h2" />
          <TextBlock TextWrapping="Wrap" Text="Hệ thống lưu trữ sản phẩm truyền thông dân số — ứng dụng đồng bộ tư liệu xuống máy tính." />
          <Button Content="Xuất gói chẩn đoán…" Command="{Binding ExportDiagnosticsCommand}" HorizontalAlignment="Left" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="Gói chẩn đoán gồm nhật ký và thông tin hệ thống để gửi bộ phận hỗ trợ; không chứa mật khẩu, mã đăng nhập hay nội dung tệp." />
          <Button Content="Gửi yêu cầu hỗ trợ" Command="{Binding SupportCommand}" HorizontalAlignment="Left" />
          <TextBlock Text="Cập nhật" Classes="h2" Margin="0,12,0,0" />
          <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding UpdatesAvailable}">
            <Button Content="Kiểm tra bản cập nhật" Command="{Binding CheckUpdateCommand}" />
            <Button Content="Khởi động lại để cập nhật" Command="{Binding RestartToUpdateCommand}" IsVisible="{Binding CanRestartToUpdate}" Classes="accent" />
          </StackPanel>
          <CheckBox IsChecked="{Binding BetaChannel}" IsVisible="{Binding UpdatesAvailable}" Content="Nhận bản thử nghiệm (beta) trước khi phát hành chính thức" />
          <TextBlock Text="Cùng soạn thảo bằng ONLYOFFICE" Classes="h2" Margin="0,12,0,0" />
          <TextBlock Text="{Binding OnlyOfficeStatus}" TextWrapping="Wrap" />
          <Button Content="Cài BlueDrive vào ONLYOFFICE" Command="{Binding InstallProviderCommand}" IsVisible="{Binding CanInstallProvider}" HorizontalAlignment="Left" />
          <Button Content="Cài / cập nhật ONLYOFFICE Desktop Editors" Command="{Binding InstallOnlyOfficeCommand}" IsVisible="{Binding CanInstallOnlyOffice}" HorizontalAlignment="Left" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="ONLYOFFICE Desktop Editors © Ascensio System SIA, phần mềm nguồn mở theo giấy phép GNU AGPL v3 (https://www.onlyoffice.com, mã nguồn: https://github.com/ONLYOFFICE/DesktopEditors). BlueDrive chỉ cài bộ cài gốc không chỉnh sửa và thêm cấu hình kết nối &quot;bluedrive&quot;." />
          <TextBlock Text="{Binding AboutMessage}" TextWrapping="Wrap" Foreground="#0b5394" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
