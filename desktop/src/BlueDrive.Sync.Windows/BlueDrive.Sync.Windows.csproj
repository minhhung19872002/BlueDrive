<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Builds on the Linux CI runners too; the tests only run on Windows (scripts/ci.ps1). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>BlueDrive.Sync.Windows</RootNamespace>
    <Description>Windows Files On-Demand provider for BlueDrive Desktop: Cloud Files API (sync root, placeholders, hydration, pin state).</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BlueDrive.Sync.Agent\BlueDrive.Sync.Agent.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BlueDrive.Sync.Windows.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.369">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
