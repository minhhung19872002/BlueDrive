<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>1.0.0</Version>
    <Company>BlueDrive</Company>
    <Product>BlueDrive - Hệ thống lưu trữ sản phẩm truyền thông dân số</Product>
    <SourceRevisionId Condition="'$(GIT_SHA)' != ''">$(GIT_SHA)</SourceRevisionId>
  </PropertyGroup>
</Project>
