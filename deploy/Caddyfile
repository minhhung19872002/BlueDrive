{
	# Automatic HTTPS (Let's Encrypt) is enabled when SITE_ADDRESS is a real domain, e.g. drive.example.gov.vn.
	# With SITE_ADDRESS=":80" (default, local) Caddy serves plain HTTP.
	email {$ACME_EMAIL:admin@localhost}
	servers {
		protocols h1 h2
		# Behind another TLS-terminating proxy (TRUSTED_PROXIES=its subnet): keep its X-Forwarded-Proto/For.
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# ONLYOFFICE Document Server is published under /office (virtual path).
	handle_path /office/* {
		reverse_proxy onlyoffice:80 {
			# {hostport}, not {host}: keep a non-default port (e.g. :8088) in the URLs Document Server hands to clients.
			# X-Forwarded-Proto is set by Caddy itself (passed through from trusted proxies).
			header_up X-Forwarded-Host {hostport}/office
		}
	}

	handle {
		reverse_proxy web:80 {
			flush_interval -1
			transport http {
				read_timeout 1h
				write_timeout 1h
			}
		}
	}

	request_body {
		max_size 0
	}
}
