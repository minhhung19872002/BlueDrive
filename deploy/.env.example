# ===== BlueDrive - cấu hình triển khai =====
# Sao chép thành deploy/.env rồi điền giá trị. KHÔNG commit file .env.
# Có thể sinh tự động bằng: powershell -File scripts/install.ps1 (tự tạo secret ngẫu nhiên).

# --- Địa chỉ truy cập ---
# Local: để SITE_ADDRESS=:80 và PUBLIC_BASE_URL=http://localhost
# Có domain: SITE_ADDRESS=drive.example.gov.vn và PUBLIC_BASE_URL=https://drive.example.gov.vn (Caddy tự cấp TLS)
SITE_ADDRESS=:80
PUBLIC_BASE_URL=http://localhost
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
# Đặt sau một reverse proxy khác (đã có HTTPS): dải IP của proxy đó, ví dụ 172.16.0.0/12 (mạng Docker)
TRUSTED_PROXIES=127.0.0.1/32

ORGANIZATION_NAME=Trung tâm Thông tin, Chuyển đổi số và Dịch vụ dân số

# --- CSDL PostgreSQL ---
POSTGRES_DB=bluedrive
POSTGRES_USER=bluedrive
POSTGRES_PASSWORD=change_me_postgres

# --- Bảo mật ---
# Chuỗi ngẫu nhiên >= 32 ký tự
JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long
# Tối thiểu 32 ký tự
ONLYOFFICE_JWT_SECRET=change_me_onlyoffice_secret_32_chars_min
# Khóa chủ AES-256 (base64 của 32 byte). Sinh: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
STORAGE_MASTER_KEY=
STORAGE_ENCRYPT_AT_REST=true

# --- Tài khoản quản trị mặc định (username: admin, bắt buộc đổi mật khẩu lần đầu) ---
ADMIN_PASSWORD=change_me_Admin@123
ADMIN_EMAIL=
# true: tạo dữ liệu mẫu (đơn vị, 5 người dùng, 2 nhóm, file mẫu)
SEED_DEMO=false
# Mật khẩu ban đầu của 5 người dùng mẫu (bắt buộc đổi khi đăng nhập lần đầu); cần khi SEED_DEMO=true
DEMO_PASSWORD=Demo@12345

# --- Lưu trữ file: local (volume) hoặc s3 ---
STORAGE_PROVIDER=local
S3_SERVICE_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
BACKUP_S3_ENABLED=false

# --- Quét mã độc ClamAV (bật thêm: docker compose --profile clamav up -d) ---
CLAMAV_ENABLED=false

# --- Email SMTP (quên mật khẩu, cảnh báo) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

APP_VERSION=latest
GIT_SHA=dev
